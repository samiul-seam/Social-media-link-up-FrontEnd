{
  "expo": {
    "name": "linkUp",
    "slug": "linkUp-client",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "linkupclient",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },
    "android": {
      "edgeToEdgeEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.anonymous.linkUpclient",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2563EB"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a649805e-7c05-451a-8f35-1a61153c8164"
      }
    }
  }
}